<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ always shows a system start screen first. Give it the Techyverve logo
         (same size and place as the app's start screen) instead of the app icon. -->
    <style name="LauncherTheme" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/backgroundColor</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/backgroundColor</item>
    </style>
</resources>
