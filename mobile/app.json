{
  "expo": {
    "name": "Master Bill",
    "slug": "master-bill",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF6F2"
    },
    "ios": {
      "bundleIdentifier": "in.techyverve.masterbill",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Master Bill connects to your Bluetooth receipt printer to print bills and kitchen tickets.",
        "NSBluetoothPeripheralUsageDescription": "Master Bill connects to your Bluetooth receipt printer to print bills and kitchen tickets.",
        "NSLocalNetworkUsageDescription": "Master Bill sends bills to your Wi-Fi receipt printer on this network.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.techyverve.masterbill",
      "versionCode": 22,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-bg.png",
        "backgroundColor": "#F86A06"
      },
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "neverForLocation": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
            "node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
            "node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
            "node_modules/@expo-google-fonts/inter/800ExtraBold/Inter_800ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FAF6F2"
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Master Bill uses the microphone for voice search of dish names.",
          "speechRecognitionPermission": "Master Bill turns your voice into dish names for search."
        }
      ]
    ],
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000",
      "barStyle": "dark-content"
    },
    "web": {
      "name": "Master Bill 2.0",
      "shortName": "Master Bill",
      "themeColor": "#C2410C",
      "backgroundColor": "#FAF6F2",
      "favicon": "./assets/icon.png",
      "output": "single",
      "bundler": "metro",
      "display": "standalone"
    },
    "experiments": {
      "baseUrl": "/v2"
    }
  }
}
